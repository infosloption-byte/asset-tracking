<script type="text/javascript">

	var id = 0;

	$(document).ready(function(){
		
		$('.btn-excel').click(function(e){
			e.preventDefault();

        	from_date = $("#from_date").val();
			to_date = $("#to_date").val();
			type = $("#module").val();
			user = $("#user").val();

        	window.location.href = '<?php echo e(url('reports/audit-trail-report/download/excel')); ?>?module='+type+'&from_date='+from_date+'&to_date='+to_date+'&user='+user;

		});

		$('.btn-pdf').click(function(e){
			e.preventDefault();

        	from_date = $("#from_date").val();
			to_date = $("#to_date").val();
			type = $("#module").val();
			user = $("#user").val();

        	window.open('<?php echo e(url('reports/audit-trail-report/download/pdf')); ?>?module='+type+'&from_date='+from_date+'&to_date='+to_date+'&user='+user,'_blank');

		});
	});

	function pageReload(){
		window.location.href = window.location.href;
	}

	var app = angular.module("ngApp",['angularMoment','dualmultiselect','angularImgFallback','ui.bootstrap','ngSanitize','bw.paging','ngPrettyJson']);

    app.config(['$tooltipProvider', function ($tooltipProvider) {
        $tooltipProvider.options({
            appendToBody: true, // 
            appendToBody: true, // 
            placement:'bottom' // Set Default Placement
        });
    }]);

    //controller
    app.controller("ReportManageController", function($scope)
    {
    	$scope.audits = [];

    	$scope.page = 1;

    	$scope.find = function (page)
	    {
	    	$scope.page = page;

            $.ajax({
	            url: "<?php echo e(url('reports/audit-trail-data')); ?>",
	            type: 'GET',
	            data: {
	            	page: page,
	            	from_date : $("#from_date").val(),
					to_date : $("#to_date").val(),
					type : $("#module").val(),
					user : $("#user").val()
	            },
	            success: function (data) {

	            	if(data.data.length>0){
	            		$('.btn-pdf').removeClass('disabled');
                		$('.btn-excel').removeClass('disabled');
                	}else{
                		$('.btn-pdf').addClass('disabled');
                		$('.btn-excel').addClass('disabled');
                	}

	                $scope.audits = data;
	                $scope.$apply();

	            },
	            error:function(data) {
	              $('.dialog-loader').hide();
	            }
	        });
	    }
    });

</script>
