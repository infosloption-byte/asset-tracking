<script type="text/javascript">

	var id = 0;

	$(document).ready(function(){
		
		$('.btn-excel').click(function(e){
			e.preventDefault();

        	serial = $("#serial").val();
			category = $("#category").val();
        	supplier = $("#supplier").val();
        	manufacturer = $("#manufacturer").val();

        	window.location.href = '<?php echo e(url('reports/software-report/download/excel')); ?>?serial='+serial+'&category='+category+'&supplier='+supplier+'&manufacturer='+manufacturer;

		});

		$('.btn-pdf').click(function(e){
			e.preventDefault();

        	serial = $("#serial").val();
			category = $("#category").val();
        	supplier = $("#supplier").val();
        	manufacturer = $("#manufacturer").val();

        	window.open('<?php echo e(url('reports/software-report/download/pdf')); ?>?serial='+serial+'&category='+category+'&supplier='+supplier+'&manufacturer='+manufacturer,'_blank');

		});
	});

	function pageReload(){
		window.location.href = window.location.href;
	}

	var app = angular.module("ngApp",['angularMoment','dualmultiselect','angularImgFallback','ui.bootstrap','ngSanitize','bw.paging']);

    app.config(['$tooltipProvider', function ($tooltipProvider) {
        $tooltipProvider.options({
            appendToBody: true, // 
            appendToBody: true, // 
            placement:'bottom' // Set Default Placement
        });
    }]);

    //controller
    app.controller("ReportManageController", function($scope)
    {
    	$scope.softwares = [];

    	$scope.page = 1;

    	$scope.find = function (page)
	    {
	    	$scope.page = page;

            $.ajax({
	            url: "<?php echo e(url('reports/software-report-data')); ?>",
	            type: 'GET',
	            data: {
	            	page: page,
	            	serial : $("#serial").val(),
					category : $("#category").val(),
		        	supplier : $("#supplier").val(),
		        	manufacturer : $("#manufacturer").val()
	            },
	            success: function (data) {

	            	if(data.data.length>0){
	            		$('.btn-pdf').removeClass('disabled');
                		$('.btn-excel').removeClass('disabled');
                	}else{
                		$('.btn-pdf').addClass('disabled');
                		$('.btn-excel').addClass('disabled');
                	}

	                $scope.softwares = data;
	                $scope.$apply();

	            },
	            error:function(data) {
	              $('.dialog-loader').hide();
	            }
	        });
	    }
    });

</script>
