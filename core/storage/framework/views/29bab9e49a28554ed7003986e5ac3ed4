  <script type="text/javascript">
    var id = 0;
    stage=0;
    
    $(document).ready(function(){
        $('#time_container').perfectScrollbar();
        $(".panel").addClass('panel-refreshing');

        $('.btn-find').click(function () {
            load_bucket_data(id);
        });

        $('.btnStatus').click(function () {
            var type = $(this).data('id');
            $(".panel").addClass('panel-refreshing');
            load_cat_data(type,id);         
        });

        $("#checkin_link").prop("href", "<?php echo e(url('check-inout/checkin')); ?>?location="+$('#location').val());

        $('#location').change(function () {
            $(".panel").addClass('panel-refreshing');
            id = $(this).val();
            load_bucket_data(id);
            load_cat_data(0,id);
            load_request_data(id);

            $("#checkin_link").prop("href", "<?php echo e(url('check-inout/checkin')); ?>?location="+id);
        });

        load_bucket_data($('#location').val());

        load_cat_data(0,id); 
    });

    function load_cat_data(type,location) {
      $.ajax({
            url: "<?php echo e(url('json/loadCatData')); ?>",
            type: 'GET',
            data: {'type': type ,'location':location},
            success: function (data) {
                
                $('#catTable tbody').empty();
                
                lk=1;
                
                $.each(data.detail,function(index,value){
                    
                    $('#catTable tbody').append(
                        '<tr>'
                            +'<td>'+lk+'</td>'
                            +'<td>'
                                +'<a class="link" href="<?php echo e(url('asset/list')); ?>?model='+value.model_id+'&status='+data.status+'&location='+data.location+'">'+value.category_name+'</a>'
                            +'</td>'
                            +'<td>'+value.category_count+'('+value.status_name+')</td>'
                        +'</tr>'
                    );

                    lk++;
                });

                $(".panel").removeClass('panel-refreshing');
            },
            error: function (xhr, textStatus, thrownError) {
                console.log(thrownError);
            }
        });
    }

    function load_request_data(loc_id){
        $.ajax({
            url: "<?php echo e(url('json/request-data')); ?>",
            type: 'GET',
            data: {'location':loc_id},
            success: function (data) {
                $("#asset_request_count_text").text(data.asset_request_count);
                $("#service_request_count_text").text(data.service_request_count);
                $("#dispose_request_count_text").text(data.dispose_request_count);
                $("#checkin_count_text").text(data.checkin_pending);
                $(".panel").removeClass('panel-refreshing');
            },
            error: function (xhr, textStatus, thrownError) {
                console.log(thrownError);
            }
        });
    }

    function load_bucket_data(id){
      $.ajax({
          url: "<?php echo e(url('json/loadBucketData')); ?>" ,
          type: 'GET',
          data: {'location' :  id},
          dataType: 'json',
          success: function(data) {
              $(".panel").removeClass('panel-refreshing');
              $("#total_asset").text(data.total_asset);
              $("#deploy_asset").text(data.deploy_asset);
              $("#undeploy_asset").text(data.undeploy_asset);
              $("#pending_asset").text(data.service_asset);
              // $("#damage_asset").text(data.damage_asset);
              $("#damage_asset").text(data.disposed_asset);

              $("#total_asset_des").text("Rs. "+data.total_value.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ","));
              $("#deploy_asset_des").text("Rs. "+data.deploy_value.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ","));
              $("#undeploy_asset_des").text("Rs. "+data.undeploy_value.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ","));
              $("#pending_asset_des").text("Rs. "+data.service_value.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ","));
              $("#damage_asset_des").text("Rs. "+data.disposed_value.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ","));

              $("#bucket_row").show();


              var chart = AmCharts.makeChart("chartdiv", {
                  "type": "pie",
                  "startDuration": 0,
                  "theme": "light",
                  "addClassNames": true,
                  "legend":{
                      "position":"bottom",
                      "marginRight":100,
                      "autoMargins":false
                  },
                  "innerRadius": "50%",
                  "defs": {
                      "filter": [{
                          "id": "shadow",
                          "width": "300%",
                          "height": "300%",
                          "feOffset": {
                              "result": "offOut",
                              "in": "SourceAlpha",
                              "dx": 0,
                              "dy": 0
                          },
                          "feGaussianBlur": {
                              "result": "blurOut",
                              "in": "offOut",
                              "stdDeviation": 5
                          },
                          "feBlend": {
                              "in": "SourceGraphic",
                              "in2": "blurOut",
                              "mode": "normal"
                          }
                      }]
                  },
                  "dataProvider": [ {
                      "country": "DEPLOYED",
                      "litres": data.deploy_asset
                  }, {
                      "country": "UN-DEPLOYED",
                      "litres": data.undeploy_asset
                  }, {
                      "country": "IN-SERVICE",
                      "litres": data.service_asset
                  }, {
                      "country": "DIPOSED",
                      "litres": data.disposed_asset
                  }],
                  "valueField": "litres",
                  "titleField": "country",
                  "export": {
                      "enabled": true
                  }
              });

              chart.addListener("init", handleInit);

              chart.addListener("rollOverSlice", function(e) {
                  handleRollOver(e);
              });

              function handleInit(){
                  chart.legend.addListener("rollOverItem", handleRollOver);
              }

              function handleRollOver(e){
                  var wedge = e.dataItem.wedge.node;
                  wedge.parentNode.appendChild(wedge);
              }
          },
          error: function(xhr, textStatus, thrownError) {
              console.log(thrownError);
          }
      });
    }




  </script>
