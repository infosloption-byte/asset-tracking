<script type="text/javascript">
	
	$(document).ready(function(){
	   $('.type-activate').change(function(){
            $('.panel').addClass('panel-refreshing');
            if($(this).prop('checked')==true){                  
                ajaxRequest( '<?php echo e(url('software/type/status')); ?>' , { 'id' : $(this).val() , 'status' : 1 }, 'post', successFunc);
            }else{                  
                ajaxRequest( '<?php echo e(url('software/type/status')); ?>' , { 'id' : $(this).val() , 'status' : 0 }, 'post', successFunc);
            }
        });	
	});

	function successFunc(data){
        if(data.status=='success'){
            $('.panel').removeClass('panel-refreshing');
            sweetAlert('Success','Action Successfully Done!',0);
    		window.location.reload();
        }else{
            sweetAlert('Error Occured','Please try again!',3);
        }
	}
</script>
