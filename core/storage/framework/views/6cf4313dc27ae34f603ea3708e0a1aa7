<script src="<?php echo e(asset('assets/sammy_new/vendor/jquery-validation/dist/jquery.validate.min.js')); ?>"></script>
<script type="text/javascript">

	var langs = JSON.parse('<?php echo json_encode($old); ?>');

	specs=langs.spec_field;
	sub_loc=langs.sub_loc;

	if(sub_loc==1){
		$('#sub_loc').prop('checked',true);
	}

	$(document).ready(function(){

		onlaod();

		$('#model').change(function(){
			
            $(".panel").addClass('panel-refreshing');
            $('#modal-field-specs').html("");
		 	$.ajax({
                url: "<?php echo e(url('reports/json/get_specs')); ?>" ,
                type: 'get',
                data: {'model' :  $(this).val()},
                success: function(data) {
	                $.each(data,function(key,value){
	                    $('#modal-field-specs').append('<option value="'+value.id+'" selected data-name="'+value.name+'">'+value.name+'</option>');
	                });
	                $('#modal-field-specs').trigger("chosen:updated");
	                $('.panel').removeClass('panel-refreshing');
                },
                error: function(xhr, textStatus, thrownError) {
                    console.log(thrownError);
                }
            });
		});

		$('.btn-search').click(function(e){
			e.preventDefault();
            // $(".panel").addClass('panel-refreshing');
            $('.search-form').submit();

            $('.btn-excel').css('display','inline-block');
            $('.btn-pdf').css('display','inline-block');
		});

		$('.btn-excel').click(function(e){
			e.preventDefault();

        	loc = $("#location").val();
        	model = $("#model").val();
        	status = $("#status").val();
			sub_loc = ($("#sub_loc:checked").length > 0)?$("#sub_loc:checked").val():0;
        	loc_type = $("#location_type").val();
        	modal_field_basic = $("#modal-field-basic").val();
        	modal_field_specs = $("#modal-field-specs").val();

        	window.location.href = '<?php echo e(url('reports/download/excel')); ?>?location='+loc+'&model='+model+'&status='+status+'&modal-field-basic='+modal_field_basic+'&modal-field-specs='+modal_field_specs+'&sub_loc='+sub_loc+'&loc_type='+loc_type;

		});

		$('.btn-pdf').click(function(e){
			e.preventDefault();

        	loc = $("#location").val();
        	model = $("#model").val();
        	status = $("#status").val();
			sub_loc = ($("#sub_loc:checked").length > 0)?$("#sub_loc:checked").val():0;
			loc_type = $("#location_type").val();
        	modal_field_basic = $("#modal-field-basic").val();
        	modal_field_specs = $("#modal-field-specs").val();

        	window.open('<?php echo e(url('reports/download/pdf')); ?>?location='+loc+'&model='+model+'&status='+status+'&modal-field-basic='+modal_field_basic+'&modal-field-specs='+modal_field_specs+'&sub_loc='+sub_loc+'&loc_type='+loc_type,'_blank');

		});

	});

	function onlaod(){

		$(".panel").addClass('panel-refreshing');
        $('#modal-field-specs').html("");
	 	$.ajax({
            url: "<?php echo e(url('reports/json/get_specs')); ?>" ,
            type: 'get',
            data: {'model' :  $("#model").val()},
            success: function(data) {

                $.each(data,function(key,value){
               		i=0;
                    $.each(specs,function(index,val){
                		if(value.id==val){
                			i++;

                		}
                	});
                	if(i==1){
                		$('#modal-field-specs').append('<option value="'+value.id+'" selected data-name="'+value.name+'">'+value.name+'</option>');
                	}else{
                		$('#modal-field-specs').append('<option value="'+value.id+'" data-name="'+value.name+'">'+value.name+'</option>');
                	}
                });
                $('#modal-field-specs').trigger("chosen:updated");
                $('.panel').removeClass('panel-refreshing');
            },
            error: function(xhr, textStatus, thrownError) {
                console.log(thrownError);
            }
        });
	}

	
</script>
