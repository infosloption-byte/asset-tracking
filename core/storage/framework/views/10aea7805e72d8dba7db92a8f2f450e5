<script type="text/javascript">

	var id = 0;

	$(document).ready(function(){
		
		$('.btn-excel').click(function(e){
			e.preventDefault();

        	loc = $('#location').val();
			inventory_no = $('#inv_no').val();
			ser_no = $('#ser_no').val();
			status = $('#status').val();
			model = $('#model').val();

        	window.location.href = '<?php echo e(url('reports/depreciation/download/excel')); ?>?loc='+loc+'&inventory_no='+inventory_no+'&ser_no='+ser_no+'&status='+status+'&model='+model;

		});

		$('.btn-pdf').click(function(e){
			e.preventDefault();

        	loc = $('#location').val();
			inventory_no = $('#inv_no').val();
			ser_no = $('#ser_no').val();
			status = $('#status').val();
			model = $('#model').val();

        	window.open('<?php echo e(url('reports/depreciation/download/pdf')); ?>?loc='+loc+'&inventory_no='+inventory_no+'&ser_no='+ser_no+'&status='+status+'&model='+model,'_blank');

		});
	});

	function pageReload(){
		window.location.href = window.location.href;
	}

	var app = angular.module("ngApp",['angularMoment','dualmultiselect','angularImgFallback','ui.bootstrap','ngSanitize','bw.paging']);

    app.config(['$tooltipProvider', function ($tooltipProvider) {
        $tooltipProvider.options({
            appendToBody: true, // 
            appendToBody: true, // 
            placement:'bottom' // Set Default Placement
        });
    }]);

    //controller
    app.controller("ReportManageController", function($scope)
    {
    	$scope.asset_data = [];

    	$scope.page = 1;

    	$scope.find = function (page)
	    {
	    	$scope.page = page;

            $.ajax({
	            url: "<?php echo e(url('reports/depreciation/asset/json')); ?>",
	            type: 'GET',
	            data: {
	            	page: page,
	            	location : $('#location').val(),
					inventory_no : $('#inv_no').val(),
					ser_no : $('#ser_no').val(),
					status : $('#status').val(),
					model : $('#model').val()
	            },
	            success: function (data) {

	            	if(data.data.length>0){
	            		$('.btn-pdf').removeClass('disabled');
                		$('.btn-excel').removeClass('disabled');
                	}else{
                		$('.btn-pdf').addClass('disabled');
                		$('.btn-excel').addClass('disabled');
                	}

	                $scope.asset_data = data;
	                $scope.$apply();
	            },
	            error:function(data) {
	              $('.dialog-loader').hide();
	            }
	        });
	    }
    });

</script>
