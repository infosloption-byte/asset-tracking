FROM php:7.1-apache

# Laravel 5.1's default Encrypter requires mcrypt (removed from PHP core in 7.2+,
# and from Debian's own package repos on newer releases) - this is why we're
# pinned to PHP 7.1 rather than anything newer. libmcrypt-dev must come from
# Debian's archived stretch repo since it's gone from later Debian releases.
RUN apt-get update && apt-get install -y \
        libmcrypt-dev \
        libzip-dev \
        libpng-dev \
        libxml2-dev \
        unzip \
        git \
    && docker-php-ext-install -j$(nproc) mcrypt pdo_mysql mysqli mbstring zip gd xml \
    && a2enmod rewrite headers \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /var/www/html

# Install Composer
COPY --from=composer:1 /usr/bin/composer /usr/bin/composer

# Copy the whole repo (index.php + .htaccess at root, framework in core/)
COPY . /var/www/html/

# Composer 1 is required here: composer.lock was generated by an old Composer
# version and several deps (e.g. clegginabox/pdf-merger, itbz/fpdi) are pinned
# to "dev-master", which newer Composer/Packagist metadata handles differently.
RUN cd core \
    && composer install --no-dev --optimize-autoloader --no-interaction --ignore-platform-reqs

# Writable dirs Laravel needs at runtime
RUN chown -R www-data:www-data /var/www/html \
    && chmod -R 775 core/storage core/bootstrap/cache

EXPOSE 80